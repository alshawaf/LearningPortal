# PostgreSQL owner is used only by migrations and bootstrap scripts.
POSTGRES_DB=masar_code
POSTGRES_USER=masar_owner
POSTGRES_PASSWORD=replace-with-a-long-random-owner-password
APP_DB_USER=masar_api
APP_DB_PASSWORD=replace-with-a-different-long-random-api-password
DATABASE_ADMIN_URL=postgresql://masar_owner:replace-with-a-long-random-owner-password@127.0.0.1:5432/masar_code
DATABASE_URL=postgresql://masar_api:replace-with-a-different-long-random-api-password@127.0.0.1:5432/masar_code

# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
TRUSTED_PROXY=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
SESSION_TTL_HOURS=8
DATABASE_POOL_MAX=10
IP_HASH_SECRET=replace-with-at-least-32-random-characters
PRACTICE_RUNNER_IMAGE=python:3.12-alpine
PRACTICE_RUNNER_TIMEOUT_MS=20000
PRACTICE_RUNNER_URL=http://127.0.0.1:4001
PRACTICE_RUNNER_SHARED_SECRET=replace-with-a-distinct-random-secret-of-at-least-32-characters
RUNNER_HOST=127.0.0.1
RUNNER_PORT=4001
RUNNER_MAX_CONCURRENCY=2
RUNNER_MAX_QUEUE=100

# One-time administrator bootstrap. Remove these values after running db:seed.
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PHONE=+967777123456
BOOTSTRAP_ADMIN_NAME=مدير المنصة
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-16-character-password

# Frontend (Vite)
VITE_API_BASE_URL=/api/v1
