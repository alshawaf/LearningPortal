FROM node:22.22-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY index.html vite.config.js ./
COPY src ./src
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_RELEASE_MODE=pilot-practices
ARG VITE_SUPPORT_EMAIL
ARG VITE_DATA_RETENTION_DAYS=365
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL VITE_RELEASE_MODE=$VITE_RELEASE_MODE VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL VITE_DATA_RETENTION_DAYS=$VITE_DATA_RETENTION_DAYS
RUN pnpm build:web

FROM nginx:1.29-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
