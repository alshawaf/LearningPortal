{
  "name": "learning-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:api && concurrently -k -n WEB,API,RUNNER -c cyan,blue,magenta \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:runner\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/dist/index.js",
    "dev:runner": "node --watch server/dist/runner/index.js",
    "build": "pnpm build:web && pnpm build:api",
    "build:web": "vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "preview": "vite preview --host 0.0.0.0",
    "start:api": "node server/dist/index.js",
    "start:runner": "node server/dist/runner/index.js",
    "db:migrate": "pnpm build:api && node server/dist/scripts/migrate.js",
    "db:seed": "pnpm build:api && node server/dist/scripts/seed-admin.js",
    "db:export:practices": "pnpm build:api && node server/dist/scripts/export-practices.js",
    "db:seed:programming-practices": "pnpm build:api && node server/dist/scripts/seed-programming-basics-practices.js",
    "test": "pnpm build:api && node --test server/dist/security/password.test.js server/dist/security/identity.test.js",
    "test:phone-login": "pnpm build:api && node server/dist/scripts/smoke-phone-login.js",
    "test:user-admin": "pnpm build:api && node server/dist/scripts/smoke-user-administration.js",
    "test:course-admin": "pnpm build:api && node server/dist/scripts/smoke-course-administration.js",
    "test:course-enrollments": "pnpm build:api && node server/dist/scripts/smoke-course-enrollments.js",
    "test:practice": "pnpm build:api && node server/dist/scripts/smoke-practice-exercises.js",
    "test:student-activity": "pnpm build:api && node server/dist/scripts/smoke-student-activity.js",
    "test:student-registration": "pnpm build:api && node server/dist/scripts/smoke-student-registration.js",
    "test:architecture": "pnpm build:api && node server/dist/scripts/smoke-platform-architecture.js",
    "test:academic-structure": "pnpm build:api && node server/dist/scripts/smoke-academic-structure.js",
    "test:integration": "pnpm build:api && node server/dist/scripts/smoke-auth.js"
  },
  "dependencies": {
    "@fastify/cookie": "latest",
    "@fastify/cors": "latest",
    "@fastify/helmet": "latest",
    "@fastify/rate-limit": "latest",
    "@node-rs/argon2": "latest",
    "@vitejs/plugin-react": "latest",
    "dotenv": "latest",
    "fastify": "latest",
    "vite": "latest",
    "typescript": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "concurrently": "latest"
  }
}
